{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^14.0.0",
      "yaml@1": "^1.10.3",
      "yaml@2": "^2.8.3",
      "esbuild": "^0.28.1",
      "markdown-it": "^14.2.0",
      "brace-expansion": "5.0.9",
      "picomatch": "4.0.5",
      "ws": "8.21.3",
      "protobufjs": "7.6.5",
      "shell-quote": "1.9.0",
      "tar": "7.5.21",
      "node-forge": "1.4.0",
      "undici": "^6.28.0",
      "@xmldom/xmldom": "^0.8.15",
      "postcss": "^8.5.23",
      "qs": "^6.16.0",
      "@babel/core": "^7.29.6",
      "body-parser": "^2.3.0",
      "fast-uri": "^3.1.7",
      "browserslist": "^4.28.7",
      "decode-uri-component": "^0.5.0",
      "linkify-it": "5.0.2",
      "nanoid": "3.3.18",
      "path-to-regexp": "8.4.0",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "lodash": "4.18.0"
    }
  }
}
