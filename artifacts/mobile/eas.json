{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "EXPO_PUBLIC_DOMAIN": "https://blousley.replit.app"
      }
    },
    "fit-checkout-diagnostics": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "https://blousley.replit.app",
        "EXPO_PUBLIC_ENABLE_FIT_CHECKOUT_DIAGNOSTICS": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DOMAIN": "https://blousley.replit.app"
      }
    }
  }
}